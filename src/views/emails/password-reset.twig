{#
Password reset email
Variables: store, user, reset_url
#}
<!DOCTYPE html>
<html lang="{{ theme.is_rtl ? 'ar' : 'en' }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ theme.is_rtl ? 'إعادة تعيين كلمة المرور' : 'Password Reset' }}</title>
  <style>
    body { margin:0; padding:0; background:#f6f1e8; font-family:'Arial',sans-serif; color:#2a201a; }
    .email-wrap { max-width:600px; margin:0 auto; background:#faf5ec; }
    .email-header { background:#2a201a; padding:32px 40px; text-align:center; }
    .email-header img { max-width:160px; }
    .email-header-brand { color:#b89464; font-size:10px; letter-spacing:0.4em; text-transform:uppercase; margin-top:8px; }
    .email-body { padding:40px; text-align:center; }
    .email-title { font-size:24px; font-weight:normal; margin:0 0 8px; }
    .email-text { font-size:13px; color:#4a3f37; line-height:1.8; margin:0 0 32px; }
    .btn { display:inline-block; background:#2a201a; color:#faf5ec !important; text-decoration:none; padding:16px 40px; font-size:11px; letter-spacing:0.35em; text-transform:uppercase; border-radius:2px; }
    .note { font-size:11px; color:#b8a98f; margin-top:24px; line-height:1.6; }
    .email-footer { background:#2a201a; padding:24px 40px; text-align:center; }
    .email-footer p { color:#b8a98f; font-size:11px; letter-spacing:0.15em; margin:4px 0; }
    .email-footer a { color:#b89464; text-decoration:none; }
  </style>
</head>
<body>
<div class="email-wrap">

  <div class="email-header">
    {% if store.logo %}
      <img src="{{ store.logo }}" alt="{{ store.name }}">
    {% else %}
      <p style="color:#faf5ec;font-size:20px;letter-spacing:0.1em;">{{ store.name }}</p>
    {% endif %}
    <p class="email-header-brand">MY ELEGANT KID · HAIL</p>
  </div>

  <div class="email-body">
    <h1 class="email-title">
      {{ theme.is_rtl ? 'إعادة تعيين كلمة المرور' : 'Reset your password' }}
    </h1>
    <p class="email-text">
      {{ theme.is_rtl
        ? 'تلقينا طلباً لإعادة تعيين كلمة مرور حسابك. انقري على الزر أدناه لإعادة التعيين.'
        : 'We received a request to reset your account password. Click the button below to proceed.' }}
    </p>

    <a href="{{ reset_url }}" class="btn">
      {{ theme.is_rtl ? 'إعادة تعيين كلمة المرور' : 'Reset my password' }}
    </a>

    <p class="note">
      {{ theme.is_rtl
        ? 'إذا لم تطلبي ذلك، يمكنكِ تجاهل هذا البريد بأمان. الرابط صالح لمدة ٢٤ ساعة.'
        : 'If you didn\'t request this, you can safely ignore this email. The link is valid for 24 hours.' }}
    </p>
  </div>

  <div class="email-footer">
    <p>{{ store.name }}</p>
    {% if store.contacts.email %}
      <p><a href="mailto:{{ store.contacts.email }}">{{ store.contacts.email }}</a></p>
    {% endif %}
    <p style="margin-top:16px;opacity:0.5;">© {{ "now"|date("Y") }} MY ELEGANT KID</p>
  </div>

</div>
</body>
</html>
