{#
| items                     | array     | Salla featured-products data (type: chosen_products)
| items[].products[]        | Product[] | The product objects
| component.kicker          | string    | Eyebrow text
| component.title           | string    | Section heading
#}
{% set kicker = component.kicker ?? (theme.is_rtl ? 'مختارات نادرة' : 'refined essentials') %}
{% set title  = component.title  ?? (theme.is_rtl ? 'الجواهر الثمينة' : 'Coveted Pieces') %}

{% set products = [] %}
{% for item in items %}
  {% set products = products|merge(item.products) %}
{% endfor %}

{% if products is not empty %}
<section class="mek-products-section">
  <div class="container">
    <div class="mek-section-header js-mek-reveal">
      <p class="mek-eyebrow">{{ kicker }}</p>
      <h2 class="mek-section-title mek-display">{{ title }}</h2>
    </div>

    <div class="mek-products-grid">
      {% for product in products|slice(0,8) %}
        {% include 'components/home/mek-product-card.twig' with { product: product, index: loop.index0 } %}
      {% endfor %}
    </div>

    <div class="mek-section-viewall js-mek-reveal">
      <a href="{{ link('products') }}" class="mek-link-underline">
        {{ theme.is_rtl ? 'اكتشفي المجموعة الكاملة' : 'Discover all products' }}
        <span dir="ltr">→</span>
      </a>
    </div>
  </div>
</section>
{% endif %}
