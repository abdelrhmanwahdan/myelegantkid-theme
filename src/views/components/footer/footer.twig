<footer class="mek-footer {{ theme.settings.get('footer_is_dark', true) ? 'mek-footer--dark' : 'mek-footer--light' }}">

  {# ── Main footer grid ─────────────────────────────────────────── #}
  <div class="mek-footer__inner">
    <div class="container">
      <div class="mek-footer__grid">

        {# Column 1 — Brand #}
        <div class="mek-footer__brand">
          <a href="{{ store.url }}" aria-label="{{ store.name }}">
            <img src="{{ store.logo|cdn(200) }}" width="100" height="40" loading="lazy" alt="{{ store.name }} logo">
          </a>
          <p class="mek-footer__tagline">
            {{ trans('blocks.footer.tagline') }}
          </p>
          <salla-social class="mek-footer__social"></salla-social>

          {# VAT #}
          {% if store.settings.tax.number %}
            <div class="mek-footer__vat">
              {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/">
                  <img width="36" height="45" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy"
                       class="w-9 rounded-sm opacity-80 hover:opacity-100 transition-opacity"
                       alt="VAT certificate">
                </a>
              {% endif %}
              <div>
                <p class="text-xs opacity-60 mb-0.5">{{ trans('common.elements.tax_number') }}</p>
                <b class="text-sm">{{ store.settings.tax.number }}</b>
              </div>
            </div>

            {% if store.settings.tax.certificate %}
              <salla-modal sub-title-first
                           sub-title="{{ trans('common.elements.tax_number') }}"
                           modal-title="{{ store.settings.tax.number }}"
                           id="modal-value-tax">
                <div class="flex justify-center">
                  <img class="w-full" loading="lazy"
                       data-src="{{ store.settings.tax.certificate }}"
                       alt="{{ store.settings.tax.number }}">
                </div>
              </salla-modal>
            {% endif %}
          {% endif %}
        </div>

        {# Column 2 — Explore #}
        <div class="mek-footer__col">
          <h4 class="mek-footer__col-title">{{ trans('blocks.footer.explore_title') }}</h4>
          <ul class="mek-footer__links">
            <li><a href="{{ link('products') }}">{{ trans('blocks.nav.shop') }}</a></li>
            <li><a href="{{ link('categories', '27929359') }}">{{ trans('blocks.nav.fashion') }}</a></li>
            <li><a href="{{ link('categories', '2079472173') }}">{{ trans('blocks.nav.accessories') }}</a></li>
            <li><a href="{{ link('categories', '810193087') }}">{{ trans('blocks.footer.wooden_boards') }}</a></li>
            <li><a href="{{ link('categories', '500203003') }}">{{ trans('blocks.nav.gifts') }}</a></li>
          </ul>
        </div>

        {# Column 3 — Help #}
        <div class="mek-footer__col">
          <h4 class="mek-footer__col-title">{{ trans('blocks.footer.help_title') }}</h4>
          <ul class="mek-footer__links">
            <salla-menu source="footer" class="mek-footer__salla-menu" with-cookie-preferences></salla-menu>
            <li><a href="{{ link('pages', 'contact') }}">{{ trans('blocks.footer.contact') }}</a></li>
          </ul>
        </div>

      </div>{# /.mek-footer__grid #}

      {# Newsletter strip #}
      <div class="mek-footer__newsletter">
        <div class="mek-footer__newsletter-copy">
          <p class="mek-footer__newsletter-eyebrow">{{ trans('blocks.footer.newsletter_eyebrow') }}</p>
          <h3 class="mek-footer__newsletter-heading">{{ trans('blocks.footer.newsletter_heading') }}</h3>
        </div>
        <salla-newsletter class="mek-footer__newsletter-form"></salla-newsletter>
      </div>

    </div>{# /.container #}
  </div>{# /.mek-footer__inner #}

  {# ── Bottom bar ────────────────────────────────────────────────── #}
  <div class="mek-footer__bottom">
    <div class="container flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="mek-footer__copyright">{% hook copyright %}</span>
      <salla-payments class="mek-footer__payments"></salla-payments>
      <salla-apps-icons class="mek-footer__apps"></salla-apps-icons>
    </div>
  </div>

</footer>
