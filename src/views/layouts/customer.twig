{% extends "layouts.master" %}
{% block content %}

{# ── Customer page header ──────────────────────────────── #}
<div class="mek-customer-header">
  <div class="container">
    <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
      <salla-breadcrumb></salla-breadcrumb>
    </nav>
  </div>
</div>

{# ── Customer layout ───────────────────────────────────── #}
<div class="container mek-customer-layout">
  <div class="mek-customer-grid">

    {# Sidebar nav #}
    <nav class="mek-customer-sidebar" aria-label="{{ trans('common.titles.account') }}">
      {% if is_page('customer.profile') %}
        <div class="mek-customer-sidebar__avatar">
          <div class="mek-customer-sidebar__avatar-wrap">
            <salla-file-upload profile-image value="{{ user.avatar }}">
              <span class="mek-customer-sidebar__avatar-placeholder">
                <i class="sicon-user"></i>
                <span class="mek-customer-sidebar__avatar-text">
                  {{ trans('common.uploader.choose_suitable_picture') }}
                </span>
              </span>
            </salla-file-upload>
          </div>
        </div>
      {% endif %}

      <div class="hidden lg:block">
        <salla-user-menu inline></salla-user-menu>
      </div>
    </nav>

    {# Main content #}
    <div class="mek-customer-main">
      {% block inner_title %}
        <h1 class="mek-display mek-customer-title">{{ page.title }}</h1>
      {% endblock %}

      {% block inner_content %}{% endblock %}
    </div>

  </div>
</div>
{% endblock %}
