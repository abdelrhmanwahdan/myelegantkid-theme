{#
| Variable                | Type           | Description                 |
|-------------------------|----------------|-----------------------------|
| page                    | object         |                             |
| page.title              | string         |                             |
| slides                  | ?Article[]     |                             |
| articles                | Article[]      |                             |
| categories              | BlogCategory[] |                             |
| category.is_current     | bool           |                             |
| category.name           | string         |                             |
| category.url            | string         |                             |
#}
{% extends "layouts.master" %}
{% block content %}

{# ── Blog header ────────────────────────────────────────── #}
<div class="mek-blog-header">
  <div class="container">
    <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
      <salla-breadcrumb></salla-breadcrumb>
    </nav>
    <h1 class="mek-display mek-blog-header__title js-mek-reveal">{{ page.title }}</h1>
  </div>
</div>

<div class="container mek-blog">
  <div class="mek-blog__inner">

    {# ── Category sidebar ──────────────────────────────── #}
    {% if categories|length %}
      <nav class="mek-blog__sidebar" aria-label="{{ trans('pages.blog_categories.categories') }}">
        <h2 class="mek-eyebrow mek-blog__sidebar-title">{{ trans('pages.blog_categories.categories') }}</h2>
        <ul class="mek-blog__cat-list">
          {% for category in categories %}
            <li>
              <a href="{{ category.url }}"
                 class="mek-blog__cat-link {{ category.is_current ? 'is-active' : '' }}">
                {{ category.name }}
              </a>
            </li>
          {% endfor %}
        </ul>

        {# Mobile dropdown #}
        <div class="mek-blog__cat-mobile dropdown-toggler cat-filter lg:hidden">
          <button type="button"
                  class="mek-blog__cat-mobile-trigger dropdown__trigger"
                  aria-expanded="false"
                  aria-haspopup="true">
            <i class="sicon-filter pointer-events-none"></i>
            <span class="pointer-events-none">{{ trans('pages.blog_categories.categories') }}</span>
          </button>
          <div class="dropdown__menu" role="menu">
            <div class="mek-blog__cat-mobile-header">
              <h2>{{ trans('pages.blog_categories.categories') }}</h2>
              <button class="dropdown__close mek-blog__cat-mobile-close">
                <i class="sicon-cancel pointer-events-none"></i>
              </button>
            </div>
            <ul>
              {% for category in categories %}
                <li>
                  <a class="mek-blog__cat-link {{ category.is_current ? 'is-active' : '' }}"
                     href="{{ category.url }}">
                    {{ category.name }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </nav>
    {% endif %}

    {# ── Articles main area ────────────────────────────── #}
    <div class="mek-blog__main">

      {# Hero slider #}
      {% if slides|length %}
        <salla-slider
            id="blog-home-slider"
            type="blog"
            auto-play
            auto-height
            show-controls="false"
            pagination
            class="mek-blog__hero-slider block rounded-md overflow-hidden mb-8">
          <div slot="items">
            {% for article in slides %}
              <div class="swiper-slide has-overlay mek-blog__hero-slide relative bg-sand {{ article.has_image ? '' : 'no-thumb' }}"
                   style="height: 380px">
                <img class="{{ article.image.url|is_placeholder ? 'w-20 object-contain opacity-50 m-auto' : 'w-full h-full object-cover' }}"
                     src="{{ article.image.url }}"
                     alt="{{ article.image.alt }}">
                <div class="mek-blog__hero-veil" aria-hidden="true"></div>
                <div class="mek-blog__hero-caption">
                  <div data-swiper-parallax="-500">
                    <div class="mek-blog__hero-meta">
                      <span><i class="sicon-calendar-date rtl:ms-1 ltr:me-1"></i>{{ article.created_at|date }}</span>
                      <a href="{{ article.author.url }}" class="hover:underline">
                        <i class="sicon-user rtl:ms-1 ltr:me-1"></i>{{ article.author.name }}
                      </a>
                    </div>
                    <h3 class="mek-display mek-blog__hero-title">
                      <a href="{{ article.url }}">{{ article.title }}</a>
                    </h3>
                  </div>
                  <p data-swiper-parallax="-300" class="mek-blog__hero-summary line-clamp-2">{{ article.summary }}</p>
                </div>
              </div>
            {% endfor %}
          </div>
        </salla-slider>
      {% endif %}

      {# Article grid #}
      {% if articles|length %}
        {% hook 'blog:index.items.start' %}

        <salla-infinite-scroll
            class="mek-blog__grid"
            next-page="{{ articles.next_page }}"
            autoload>
          {% for article in articles %}
            <article class="mek-blog__card js-mek-reveal" style="--i: {{ loop.index0 }}">
              <a href="{{ article.url }}" class="mek-blog__card-img-wrap">
                <img class="{{ article.image.url|is_placeholder ? 'w-16 object-contain opacity-50 m-auto' : 'w-full h-full object-cover' }}"
                     src="{{ article.image.url }}"
                     alt="{{ article.image.alt }}"
                     loading="lazy">
              </a>

              <div class="mek-blog__card-body">
                <div class="mek-blog__card-meta">
                  <span><i class="sicon-calendar-date rtl:ms-1 ltr:me-1"></i>{{ article.created_at|date }}</span>
                  <a href="{{ article.author.url }}" class="hover:text-ink transition-colors">
                    <i class="sicon-user rtl:ms-1 ltr:me-1"></i>{{ article.author.name }}
                  </a>
                </div>

                <h3 class="mek-blog__card-title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h3>
                <p class="mek-blog__card-summary">{{ article.summary }}</p>

                {% if store.settings.blog.allow_likes_and_comments %}
                  <div class="mek-blog__card-engagement">
                    {% if article.likes_count %}
                      <span><i class="sicon-thumbs-up"></i> {{ article.likes_count }}</span>
                    {% endif %}
                    {% if article.comments_count %}
                      <span><i class="sicon-chat"></i> {{ article.comments_count }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              {% if article.tags|length %}
                <div class="mek-blog__card-tags">
                  {% for tag in article.tags %}
                    <a href="{{ tag.url }}" class="mek-pdp__tag">{{ tag.name }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </salla-infinite-scroll>

        {% hook 'blog:index.items.end' %}

      {% elseif not slides|length %}
        <div class="no-content-placeholder">
          <i class="sicon-inbox icon"></i>
          <p>{{ trans('pages.blog_categories.no_articles') }}</p>
        </div>
      {% endif %}
    </div>

  </div>
</div>

{% endblock %}
