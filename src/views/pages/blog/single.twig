{#
| Variable                | Type          | Description |
|-------------------------|---------------|-------------|
| article.title           | string        |             |
| article.body            | string *HTML  |             |
| article.url             | string        |             |
| article.has_image       | bool          |             |
| article.image.url       | string        |             |
| article.image.alt       | string        |             |
| article.created_at      | ?Date *Carbon |             |
| article.author.name     | string        |             |
| article.author.url      | string        |             |
| article.related         | Article[]     |             |
| article.tags            | BlogTag[]     |             |
#}
{% extends "layouts.master" %}
{% block content %}

<div class="container">
  <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>
</div>

<div class="container mek-blog-single">
  <div class="mek-blog-single__layout">

    {# ── Article ───────────────────────────────────────── #}
    <article class="mek-blog-single__article">

      <header class="mek-blog-single__header">
        <h1 class="mek-display mek-blog-single__title js-mek-reveal">{{ article.title }}</h1>
        <div class="mek-blog-single__meta">
          <span><i class="sicon-calendar-date rtl:ms-1 ltr:me-1"></i>{{ article.created_at|date }}</span>
          <a href="{{ article.author.url }}" class="hover:text-ink transition-colors">
            <i class="sicon-user rtl:ms-1 ltr:me-1"></i>{{ article.author.name }}
          </a>
          {% if store.settings.blog.allow_likes_and_comments %}
            <button id="blog-like" data-blog-id="{{ article.key }}" class="mek-blog-single__like-btn">
              <i class="sicon-thumbs-up"></i>
              <span>{{ article.likes_count }}</span>
            </button>
            {% if article.comments_count %}
              <span>
                <i class="sicon-chat"></i>
                {{ article.comments_count }}
              </span>
            {% endif %}
          {% endif %}
        </div>
      </header>

      {% if article.has_image %}
        <div class="mek-blog-single__hero-img-wrap">
          <img src="{{ article.image.url }}"
               alt="{{ article.image.alt }}"
               title="{{ article.image.alt }}"
               class="mek-blog-single__hero-img"
               loading="eager">
        </div>
      {% endif %}

      <div class="mek-blog-single__body article">
        {{ article.body|replace({'&nbsp;': ' '})|raw }}
      </div>

      {% if article.tags|length %}
        <div class="mek-blog-single__tags">
          {% for tag in article.tags %}
            <a href="{{ tag.url }}" class="mek-pdp__tag">
              <i class="sicon-tag rtl:ms-1 ltr:me-1"></i>{{ tag.name }}
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {% if store.settings.blog.allow_likes_and_comments %}
        <salla-comments item-id="{{ article.key }}" type="blog"></salla-comments>
      {% endif %}
    </article>

    {# ── Related sidebar ───────────────────────────────── #}
    {% if related|length %}
      <aside class="mek-blog-single__sidebar" aria-label="{{ trans('pages.blog_articles.related') }}">
        <h2 class="mek-eyebrow mek-blog-single__related-title">{{ trans('pages.blog_articles.related') }}</h2>

        {% hook 'blog:single.items.start' %}

        {% for art in related %}
          <a href="{{ art.url }}" class="mek-blog-single__related-card">
            <div class="mek-blog-single__related-img-wrap">
              {% if art.has_image %}
                <img src="{{ art.image.url }}" alt="{{ art.image.alt }}" class="mek-blog-single__related-img" loading="lazy">
              {% else %}
                <img src="{{ 'images/placeholder.png' | asset }}" alt="" class="mek-blog-single__related-img opacity-50">
              {% endif %}
            </div>
            <div>
              <time class="mek-blog-single__related-date">
                <i class="sicon-calendar-date rtl:ms-1 ltr:me-1"></i>{{ art.created_at|date }}
              </time>
              <h3 class="mek-blog-single__related-name">{{ art.title }}</h3>
            </div>
          </a>
        {% endfor %}

        {% hook 'blog:single.items.end' %}
      </aside>
    {% endif %}

  </div>
</div>

{% endblock %}
