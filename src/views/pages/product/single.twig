{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.price                          | float                       |                                                                        |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.is_on_sale                     | bool                        |                                                                        |
| product.is_available                   | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.category                       | ?Category                   |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.images[]                       | array                       |                                                                        |
| product.options                        | ProductOption[] *Collection |                                                                        |
| product.discount_percentage            | ?string                     |                                                                        |
| product.rating                         | ?Rating                     |                                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.tags                           | ?Tags[]                     |                                                                        |
| product.notify_availability            | ?object                     |                                                                        |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        |                                                                        |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.base_currency_price            | float                       |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.quantity                       | ?int                        |                                                                        |
| product.sold_quantity                  | int                         |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.is_taxable                     | bool                        |                                                                        |
| product.is_hidden_quantity             | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.show_availability              | bool                        |                                                                        |
| product.has_preorder_campaign          | bool                        |                                                                        |
| product.digital_files_settings         | ?object                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}

{# ── Breadcrumb ──────────────────────────────────────────── #}
<div class="container">
  <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>
</div>

{# ── Product layout ──────────────────────────────────────── #}
<section class="mek-pdp container" id="product-{{ product.id }}">
  <div class="mek-pdp__grid">

    {# ── Gallery column ─────────────────────────────────── #}
    <div class="mek-pdp__gallery">
      {% set has_many_images = product.images|length > 1 %}
      <salla-slider
          id="details-slider-{{ product.id }}"
          class="mek-pdp__slider"
          type="thumbs"
          loop="false"
          auto-height
          listen-to-thumbnails-option
          show-thumbs-controls="false">

        {% if product.promotion_title %}
          <div class="mek-pdp__promo-tag">{{ product.promotion_title }}</div>
        {% endif %}

        {# Discount badge #}
        {% if product.is_on_sale and product.discount_percentage %}
          <div class="mek-pdp__badge mek-pdp__badge--sale" aria-label="{{ product.discount_percentage }} off">
            {{ product.discount_percentage }}
          </div>
        {% endif %}

        {# Wishlist button (gallery) #}
        <salla-button
            class="mek-pdp__wishlist-btn"
            data-id="{{ product.id }}"
            onclick="salla.wishlist.toggle('{{ product.id }}')"
            shape="icon"
            fill="outline"
            color="light"
            aria-label="{{ trans('pages.wishlist.add') }}">
          <i class="sicon-heart"></i>
        </salla-button>

        {# Calories badge #}
        {% if product.calories %}
          <div class="mek-pdp__calories-badge" aria-label="{{ product.calories }} {{ trans('pages.products.calories') }}">
            <span class="mek-pdp__calories-num">{{ product.calories }}</span>
            <span class="mek-pdp__calories-label">{{ trans('pages.products.calories') }}</span>
          </div>
        {% endif %}

        <div slot="items">
          {% for image in product.images %}
            {% if image.three_d_image_url %}
              <model-viewer
                  style="min-height: 500px;"
                  class="swiper-slide model-entry w-full h-full"
                  loading="eager"
                  camera-controls
                  touch-action="pan-y"
                  auto-rotate
                  poster="{{ image.url }}"
                  src="{{ image.three_d_image_url }}"
                  shadow-intensity="1"
                  alt="{{ image.alt }}">
              </model-viewer>
            {% else %}
              <a data-fslightbox="product_{{ product.id }}"
                 data-img-id="{{ image.id }}"
                 data-slid-index="{{ loop.index - 1 }}"
                 {% if image.video_url %} data-video-src="{{ image.video_url }}"{% endif %}
                 data-caption="{{ image.alt }}"
                 data-infinite="false"
                 data-type="{{ image.video_url ? 'youtube' : 'image' }}"
                 href="{{ (image.video_url is iterable ? image.video_url|first : image.video_url)|default(image.url) }}"
                 aria-label="{{ product.name }}"
                 class="swiper-slide magnify-wrapper mek-pdp__slide {{ image.video_url ? 'video-entry' : '' }}">
                {% if loop.first %}
                  <img id="{{ image.id }}"
                       fetchpriority="high"
                       loading="eager"
                       src="{{ image.url }}"
                       alt="{{ image.alt }}"
                       class="mek-pdp__img">
                {% else %}
                  <img id="{{ image.id }}"
                       loading="lazy"
                       src="{{ image.url }}"
                       alt="{{ image.alt }}"
                       class="mek-pdp__img">
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% if has_many_images %}
          <div slot="thumbs">
            {% for image in product.images %}
              <div class="mek-pdp__thumb {{ image.video_url ? 'video-entry' : '' }} {{ image.three_d_image_url ? 'model-entry' : '' }}"
                   data-caption="{{ image.alt }}">
                <img src="{{ image.url }}"
                     loading="{{ loop.index < 5 ? 'eager' : 'lazy' }}"
                     class="mek-pdp__thumb-img"
                     title="{{ image.alt }}"
                     alt="{{ image.alt }}">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </salla-slider>
    </div>

    {# ── Info column ────────────────────────────────────── #}
    <div class="mek-pdp__info">

      {% hook 'product:single.description.start' %}

      {# Category eyebrow #}
      {% if product.category %}
        <a href="{{ product.category.url }}" class="mek-eyebrow mek-pdp__category-link">
          {{ product.category.name }}
        </a>
      {% endif %}

      {# Brand #}
      {% if product.brand.name %}
        <div class="mek-pdp__brand">
          <a href="{{ product.brand.url }}" title="{{ product.brand.name }}">
            <img src="{{ product.brand.logo }}"
                 alt="{{ product.brand.name }}"
                 title="{{ product.brand.name }}"
                 class="mek-pdp__brand-logo">
          </a>
        </div>
      {% endif %}

      <h1 class="mek-display mek-pdp__title">{{ product.name }}</h1>

      {% if product.subtitle %}
        <p class="mek-pdp__subtitle">{{ product.subtitle }}</p>
      {% endif %}

      {# Rating #}
      {% if product.rating %}
        <div class="mek-pdp__rating">
          <salla-rating-stars
              value="{{ product.rating.stars }}"
              reviews="{{ product.rating.count }}">
          </salla-rating-stars>
        </div>
      {% endif %}

      {# Price #}
      <div class="mek-pdp__price-row">
        <div class="{{ product.is_on_sale ? '' : 'hidden' }} mek-pdp__price-sale">
          <span class="mek-display mek-pdp__price-current mek-pdp__price-current--sale">{{ product.sale_price|money }}</span>
          <span class="mek-pdp__price-was">{{ product.regular_price|money }}</span>
        </div>
        <div class="{{ product.is_on_sale ? 'hidden' : '' }} mek-pdp__price-normal">
          {% if product.starting_price %}
            <span class="mek-pdp__price-starting-label">{{ trans('pages.products.starting_price') }}</span>
          {% endif %}
          <span class="mek-display mek-pdp__price-current">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
        </div>
      </div>

      {% if product.is_taxable %}
        <p class="mek-pdp__tax-note">{{ trans('pages.products.tax_included') }}</p>
      {% endif %}

      {# Description #}
      <div class="mek-pdp__desc">
        {% set product_desc = product.description|replace({"&nbsp;": "\n"}) %}
        {% if product.has_read_more %}
          <article class="mek-pdp__desc-article mek-pdp__desc-article--collapsed"
                   id="more-content"
                   style="max-height: 5.25rem">
            {{ product_desc|raw }}
          </article>
          <a id="btn-show-more" class="mek-pdp__read-more" role="button">
            {{ trans('pages.products.read_more') }}
          </a>
        {% else %}
          <article class="mek-pdp__desc-article">{{ product_desc|raw }}</article>
        {% endif %}
      </div>

      {# Tags #}
      {% if product.tags|length and theme.settings.get('show_tags', true) %}
        <div class="mek-pdp__tags">
          {% for tag in product.tags %}
            <a href="{{ tag.url }}" class="mek-pdp__tag">{{ tag.name }}</a>
          {% endfor %}
        </div>
      {% endif %}

      {# Social + wishlist strip #}
      <div class="mek-pdp__social-row">
        <salla-social-share class="mek-pdp__share" aria-label="{{ trans('common.titles.share') }}"></salla-social-share>
        <salla-button
            class="mek-pdp__wishlist-btn-info hidden sm:inline-flex"
            data-id="{{ product.id }}"
            onclick="salla.wishlist.toggle('{{ product.id }}')"
            shape="icon"
            fill="outline"
            color="light"
            aria-label="{{ trans('pages.wishlist.add') }}">
          <i class="sicon-heart"></i>
        </salla-button>
      </div>

      {# Sold / remained #}
      {% if product.sold_quantity or product.can_show_remained_quantity %}
        <div class="mek-pdp__scarcity">
          {% if product.sold_quantity %}
            <span class="mek-pdp__scarcity-item">
              <i class="sicon-fire"></i>
              {{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}
            </span>
          {% endif %}
          {% if product.can_show_remained_quantity %}
            <span class="mek-pdp__scarcity-item">
              <i class="sicon-box-bankers"></i>
              {{ trans('pages.products.remained') }} {{ product.quantity }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {# SKU #}
      {% if product.sku %}
        <div class="mek-pdp__sku">
          <span class="mek-pdp__sku-label">{{ trans('pages.products.sku') }}</span>
          <span class="mek-pdp__sku-val text-unicode">{{ product.sku }}</span>
        </div>
      {% endif %}

      {% hook 'product:single.description' %}

      {# Installment #}
      <salla-installment price="{{ product.price }}"></salla-installment>

      {# Metadata #}
      {% if product.has_metadata %}
        <salla-metadata></salla-metadata>
      {% endif %}

      {# Availability by branch #}
      {% if product.show_availability %}
        <div class="mek-pdp__availability">
          <span class="mek-eyebrow">{{ trans('pages.products.availability') }}</span>
          <a href="#!"
             onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })"
             class="mek-pdp__availability-link">
            {{ trans('pages.products.select_branch') }}
            <i class="sicon-keyboard_arrow_left"></i>
          </a>
        </div>
      {% endif %}

      {# Digital files #}
      {% if product.digital_files_settings %}
        <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
      {% endif %}

      {# ── Add-to-cart form ────────────────────────────── #}
      <form class="mek-pdp__form"
            enctype="multipart/form-data"
            method="post"
            onsubmit="return salla.form.onSubmit('cart.addItem', event)">
        <input type="hidden" name="id" value="{{ product.id }}">

        {% hook 'product:single.form.start' %}

        {% include 'pages.partials.product.options' %}

        {% hook 'product:single.form.end' %}

        {# Price summary row #}
        <div class="mek-pdp__form-price">
          <span class="mek-pdp__form-price-label">{{ trans('pages.products.price') }}</span>
          <div class="mek-pdp__form-price-val">
            <div class="{{ product.is_on_sale ? '' : 'hidden' }} price_is_on_sale">
              <span class="total-price mek-display mek-pdp__price-current mek-pdp__price-current--sale">{{ product.sale_price|money }}</span>
              <span class="before-price mek-pdp__price-was">{{ product.regular_price|money }}</span>
            </div>
            <div class="starting-or-normal-price {{ product.is_on_sale ? 'hidden' : '' }}">
              {% if product.starting_price %}
                <span class="starting-price-title mek-pdp__price-starting-label">{{ trans('pages.products.starting_price') }}</span>
              {% endif %}
              <span class="total-price mek-display mek-pdp__price-current">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
            </div>
          </div>
          <div class="out-of-stock hidden mek-pdp__out-of-stock">{{ trans('pages.products.out_of_stock') }}</div>
        </div>

        {# Pre-order countdown #}
        {% if product.has_preorder_campaign %}
          <div class="mek-pdp__preorder">
            <salla-count-down pre-order='{{ product.preorder|json_encode }}' boxed labeled></salla-count-down>
          </div>
        {% endif %}

        {# Quantity + CTA #}
        <div class="mek-pdp__cta-row sticky-product-bar">
          {% if not product.is_hidden_quantity and product.type != 'booking' %}
            <div class="mek-pdp__qty sticky-product-bar__quantity">
              <label class="mek-eyebrow mek-pdp__qty-label">{{ trans('pages.products.quantity') }}</label>
              <salla-quantity-input
                  max="{{ product.max_quantity }}"
                  value="1"
                  name="quantity"
                  aria-label="{{ trans('pages.products.quantity') }}"
                  class="mek-pdp__qty-input">
              </salla-quantity-input>
            </div>
          {% else %}
            <input type="hidden" value="1" name="quantity" aria-label="{{ trans('pages.products.quantity') }}">
          {% endif %}

          <salla-add-product-button
              {{ product.can_quick_buy ? 'quick-buy' : '' }}
              {{ theme.settings.get('sticky_add_to_cart') ? 'support-sticky-bar' : '' }}
              {{ product.is_require_shipping ? 'required-shipping' : '' }}
              {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
              amount="{{ product.base_currency_price }}"
              class="mek-pdp__add-btn sticky-product-bar__btn"
              product-status="{{ product.status }}"
              product-type="{{ product.type }}"
              product-id="{{ product.id }}"
              loader-position="end"
              type="submit"
              width="wide"
              {% if product.notify_availability %}
                {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                channels="{{ product.notify_availability.channels|join(',') }}"
                subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
              {% endif %}>
            {{ product.add_to_cart_label }}
          </salla-add-product-button>
        </div>

        {# Gifting #}
        {% if product.is_giftable %}
          <salla-gifting
              class="mek-pdp__gifting"
              widget-subtitle="{{ gifting_intro }}"
              product-id="{{ product.id }}"
              {{ product.is_require_shipping ? 'physical-products' : '' }}>
          </salla-gifting>
        {% endif %}
      </form>

      {# ── Trust details ──────────────────────────────── #}
      <div class="mek-pdp__trust">
        <div class="mek-pdp__trust-item">
          <span class="mek-pdp__trust-key">{{ trans('pages.products.shipping') }}</span>
          <span class="mek-pdp__trust-val">{{ trans('pages.products.delivery_info') }}</span>
        </div>
        <div class="mek-pdp__trust-item">
          <span class="mek-pdp__trust-key">{{ trans('pages.products.returns') }}</span>
          <span class="mek-pdp__trust-val">{{ trans('pages.products.returns_info') }}</span>
        </div>
        <div class="mek-pdp__trust-item">
          <span class="mek-pdp__trust-key">{{ trans('pages.products.packaging') }}</span>
          <span class="mek-pdp__trust-val">{{ trans('pages.products.packaging_info') }}</span>
        </div>
      </div>

      {% hook 'product:single.description.end' %}
      <salla-quick-order class="mek-pdp__quick-order"></salla-quick-order>
    </div>{# /.mek-pdp__info #}
  </div>{# /.mek-pdp__grid #}

  <salla-offer></salla-offer>
</section>

{# ── Atelier Notes strip ─────────────────────────────────── #}
<section class="mek-pdp-notes container js-mek-reveal">
  <p class="mek-eyebrow mek-pdp-notes__eyebrow">
    {{ theme.is_rtl ? 'ملاحظات الأتيليه' : 'Atelier Notes' }}
  </p>
  <div class="mek-pdp-notes__grid">
    <div class="mek-pdp-notes__item">
      <span class="mek-pdp-notes__label">{{ theme.is_rtl ? 'المواد' : 'Materials' }}</span>
      <span class="mek-pdp-notes__val">{{ theme.is_rtl ? 'قطن مصري فاخر ١٠٠٪' : '100% Premium Egyptian Cotton' }}</span>
    </div>
    <div class="mek-pdp-notes__item">
      <span class="mek-pdp-notes__label">{{ theme.is_rtl ? 'المنشأ' : 'Origin' }}</span>
      <span class="mek-pdp-notes__val">{{ theme.is_rtl ? 'مُصمَّم في حائل' : 'Designed in Hail, KSA' }}</span>
    </div>
    <div class="mek-pdp-notes__item">
      <span class="mek-pdp-notes__label">{{ theme.is_rtl ? 'العناية' : 'Care' }}</span>
      <span class="mek-pdp-notes__val">{{ theme.is_rtl ? 'غسيل ناعم ٣٠°، لا تجفيف آلي' : 'Gentle wash 30°, no tumble dry' }}</span>
    </div>
    <div class="mek-pdp-notes__item">
      <span class="mek-pdp-notes__label">{{ theme.is_rtl ? 'التغليف' : 'Packaging' }}</span>
      <span class="mek-pdp-notes__val">{{ theme.is_rtl ? 'صندوق هدايا فاخر معطّر' : 'Luxury scented gift box' }}</span>
    </div>
  </div>

  <div class="mek-pdp-notes__promise">
    <p class="mek-display mek-pdp-notes__promise-text">
      {{ theme.is_rtl
        ? 'كل قطعة تُغلَّف بعناية، وتُسلَّم كما لو كانت هدية من القلب.'
        : 'Every piece wrapped with care, delivered like a gift from the heart.' }}
    </p>
    <span class="mek-pdp-notes__brand-tag" dir="ltr">MY ELEGANT KID · HAIL</span>
  </div>
</section>

{# ── Reviews ─────────────────────────────────────────────── #}
{% if store.settings.rating.show_on_product %}
  <div class="container">
    <salla-comments item-id="{{ product.id }}" type="product"></salla-comments>
  </div>
{% endif %}

{# ── Related products ─────────────────────────────────────── #}
<div class="mek-pdp-related container">
  <div class="mek-section-header js-mek-reveal">
    <p class="mek-eyebrow">{{ theme.is_rtl ? 'قد يعجبكِ' : 'You May Also Love' }}</p>
  </div>
  <salla-products-slider
      source="related"
      source-value="{{ product.id }}"
      block-title=""
      display-all-url>
  </salla-products-slider>
</div>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
  {% if product.has_3d_image %}
    <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
  {% endif %}
  {% if product.digital_files_settings %}
    <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
  {% endif %}
{% endblock %}
