{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                    | bool        | is filters allowed here or not                                       |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}
{% block content %}

{# ── Category hero ─────────────────────────────────────────── #}
{% if category %}
  <div class="mek-cat-hero {% if category.image %}mek-cat-hero--with-img{% endif %}">
    {% if category.image %}
      <img class="mek-cat-hero__bg"
           src="{{ category.image|cdn('w=1400,h=420,fit=cover,f=webp,q=75') }}"
           alt="{{ category.name }}"
           loading="eager"
           width="1400"
           height="420">
      <div class="mek-cat-hero__veil" aria-hidden="true"></div>
    {% endif %}
    <div class="container mek-cat-hero__inner">
      <nav class="mek-breadcrumb mek-breadcrumb--light" aria-label="{{ trans('common.titles.breadcrumb') }}">
        <salla-breadcrumb></salla-breadcrumb>
      </nav>
      <h1 class="mek-display mek-cat-hero__title">{{ page.title|raw }}</h1>

      {# Sub-category pills #}
      {% if category.sub_categories|length %}
        <div class="mek-cat-hero__subs">
          {% for sub in category.sub_categories %}
            <a href="{{ sub.url }}" class="mek-cat-hero__sub-pill">{{ sub.name }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
{% else %}
  {# Generic products page (no category) #}
  <div class="container">
    <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
      <salla-breadcrumb></salla-breadcrumb>
    </nav>
    <h1 class="mek-display mek-plp__title js-mek-reveal">{{ page.title|raw }}</h1>
  </div>
{% endif %}

{# ── Listing layout ─────────────────────────────────────────── #}
<div class="container mek-plp">
  <div class="mek-plp__inner {% if filters %}mek-plp__inner--has-filters{% endif %}">

    {# ── Filters sidebar ──────────────────────────────────── #}
    {% if filters %}
      <button class="mek-plp__close-filters btn--close-sm close-filters sicon-cancel hidden"
              aria-label="{{ trans('common.form.close') }}">
      </button>
      <salla-filters
          class="mek-plp__filters"
          id="filters-menu">
      </salla-filters>
    {% endif %}

    {# ── Products area ──────────────────────────────────────── #}
    <div class="mek-plp__products">

      {# Toolbar #}
      <div class="mek-plp__toolbar">
        <div class="mek-plp__toolbar-start">
          {% if filters %}
            <a href="#filters-menu"
               class="mek-plp__filters-trigger filters-trigger lg:hidden"
               aria-label="{{ trans('blocks.products.filters') }}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="4" y1="6" x2="20" y2="6"/>
                <line x1="8" y1="12" x2="20" y2="12"/>
                <line x1="12" y1="18" x2="20" y2="18"/>
              </svg>
              <span>{{ trans('blocks.products.filters') }}</span>
            </a>
          {% endif %}
        </div>

        <div class="mek-plp__toolbar-end">
          {% if sort_options|length %}
            <div class="mek-plp__sort">
              <label class="mek-eyebrow mek-plp__sort-label hidden sm:block"
                     for="product-sort">
                {{ trans('pages.categories.sorting') }}
              </label>
              <select id="product-sort" class="mek-plp__sort-select">
                {% for sort in sort_options %}
                  <option value="{{ sort.id }}" {{ sort.is_selected ? 'selected' : '' }}>
                    {{ sort.name }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}
        </div>
      </div>

      {% hook 'product:index.items.start' %}

      <div class="mek-plp__grid-wrap">
        <salla-products-list
            class="mek-plp__list"
            source="{{ page.slug }}"
            source-value="{{ page.id }}"
            {{ filters ? 'filters-Results' : '' }}>
        </salla-products-list>
      </div>

      {% hook 'product:index.items.end' %}
    </div>
  </div>
</div>

{# ── Category testimonials (if enabled) ──────────────────── #}
{% if store.settings.category.testimonial_enabled %}
  {% component 'home.testimonials' %}
{% endif %}

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
