{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              |                                                                |
| cart.is_require_shipping                          | bool                |                                                                |
| cart.has_shipping                                 | bool                |                                                                |
| cart.real_shipping_cost                           | float               |                                                                |
| cart.sub_total                                    | float               |                                                                |
| cart.discount                                     | float               |                                                                |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               |                                                                |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       |                                                                |
#}
{% extends "layouts.master" %}
{% block content %}

<div class="container">
  <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>
  <h1 class="sr-only">{{ trans('blocks.header.cart') }}</h1>
  <salla-conditional-offer></salla-conditional-offer>

  <div class="mek-cart">
    {# ── Items column ──────────────────────────────────── #}
    <div class="mek-cart__items">
      {% hook 'cart:items.start' %}

      {% for item in cart.items %}
        <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
          <div class="mek-cart__item">
            <input type="hidden" name="id" value="{{ item.id }}">

            <div class="mek-cart__item-row">
              {# Thumbnail #}
              <a href="{{ item.url }}" class="mek-cart__item-img-wrap">
                <img src="{{ item.product_image }}"
                     alt="{{ item.product_name }}"
                     loading="{{ loop.first ? 'eager' : 'lazy' }}"
                     class="mek-cart__item-img">
                {# Free ribbon #}
                <div class="mek-cart__free-ribbon {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">
                  {{ trans('pages.loyalty_program.free_product') }}
                </div>
              </a>

              {# Info #}
              <div class="mek-cart__item-info">
                <h2 class="mek-cart__item-name">
                  <a href="{{ item.url }}">{{ item.product_name }}</a>
                </h2>

                <span class="mek-cart__item-regular {{ item.offer ? '' : 'hidden' }}">
                  {{ item.product_price|money }}
                </span>
                <span class="mek-cart__item-original {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">
                  {{ item.original_price|money }}
                </span>
                <span class="mek-cart__item-price {{ item.has_discount ? 'mek-cart__item-price--sale' : '' }}" id="has_discount">
                  {{ item.price|money }}
                </span>

                {% if item.weight_label %}
                  <p class="mek-cart__item-weight item-weight-row">
                    {{ trans('pages.products.weight') }}
                    <span class="item-weight">{{ item.weight_label }}</span>
                  </p>
                {% endif %}

                <span class="old-offers flex items-center gap-1 {{ item.detailed_offers ? 'hidden' : '' }}">
                  <i class="sicon-discount-calculator text-mist offer-icon {{ item.offer ? '' : 'hidden' }}"></i>
                  <span class="mek-cart__item-offer-name offer-name {{ item.offer ? '' : 'hidden' }}">
                    {{ item.offer.names }}
                  </span>
                </span>

                <salla-cart-item-offers
                    quantity="{{ item.quantity }}"
                    item-id="{{ item.id }}"
                    product-price="{{ item.product_price }}"
                    offers="{{ item.detailed_offers|json_encode }}">
                </salla-cart-item-offers>
              </div>

              {# Qty + total #}
              <div class="mek-cart__item-actions">
                {% if item.type == 'donating' %}
                  <span></span>
                {% elseif item.is_hidden_quantity %}
                  <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="{{ trans('pages.products.quantity') }}">
                  <span class="mek-cart__item-qty-static">{{ item.quantity }}</span>
                {% else %}
                  <salla-quantity-input
                      cart-item-id="{{ item.id }}"
                      max="{{ item.max_quantity }}"
                      class="mek-cart__qty-input"
                      aria-label="{{ trans('pages.products.quantity') }}"
                      value="{{ item.quantity }}"
                      name="quantity">
                  </salla-quantity-input>
                {% endif %}

                {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                <p class="mek-cart__item-total">
                  <span class="mek-cart__item-total-label">{{ trans('pages.cart.total') }}</span>
                  <span class="item-total">
                    {{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}
                  </span>
                </p>
              </div>
            </div>

            {% include 'pages.partials.product.options' with {product: item} %}

            {# Remove button #}
            <span class="mek-cart__item-remove">
              <salla-button
                  type="button"
                  shape="icon"
                  size="small"
                  color="danger"
                  class="btn--delete"
                  aria-label="{{ trans('common.elements.remove') }}"
                  onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').remove())">
                <i class="sicon-cancel"></i>
              </salla-button>
            </span>
          </div>
        </form>

      {% else %}
        {# Empty cart #}
        <div class="mek-cart__empty">
          <div class="mek-cart__empty-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/>
            </svg>
          </div>
          <p class="mek-cart__empty-text">{{ trans('pages.cart.empty_cart') }}</p>
          <a href="{{ link('/') }}" class="mek-btn mek-btn--ghost">
            {{ trans('common.elements.back_home') }}
          </a>
        </div>

      {% endfor %}

      {# Cart-level options #}
      {% if cart.options|length %}
        <div class="cart-options mek-cart__cart-options">
          {% for product_option in cart.options %}
            <form class="first:pt-5 relative"
                  onchange="salla.form.onChange('cart.updateItem', event)"
                  id="item-{{ product_option.id }}">
              <input type="hidden" name="id" value="{{ product_option.id }}">
              <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
              {% include 'pages.partials.product.options' with { product: product_option } %}
            </form>
          {% endfor %}
        </div>
      {% endif %}

      <salla-offer></salla-offer>
      {% hook 'cart:items.end' %}
    </div>

    {# ── Summary sidebar ───────────────────────────────── #}
    {% hook 'cart:summary.start' %}

    {% if cart.items|length %}
      <div class="mek-cart__summary">

        {# Free shipping bar #}
        <div class="mek-cart__shipping-bar {{ cart.free_shipping_bar ? '' : 'hidden' }}" id="free-shipping">
          {% set is_free = cart.free_shipping_bar.has_free_shipping %}
          <div class="mek-cart__shipping-bar-header">
            <i class="sicon-shipping-fast {{ theme.is_rtl ? 'flip-x' : '' }}"></i>
            <div>
              <p class="mek-cart__shipping-bar-title shipping-item">{{ trans('pages.cart.free_shipping') }}</p>
              <p class="mek-cart__shipping-bar-msg shipping-item">
                <span id="free-shipping-msg">
                  {{ (is_free
                    ? trans('pages.cart.has_free_shipping')
                    : trans('pages.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}))
                    | raw }}
                </span>
              </p>
            </div>
          </div>
          <div class="mek-cart__shipping-bar-track {{ is_free ? 'hidden' : '' }}" id="free-shipping-bar">
            <div class="mek-cart__shipping-bar-fill"
                 style="width: {{ cart.free_shipping_bar.percent }}%">
              <i class="sicon-shipping-fast absolute -top-5 rtl:left-0 ltr:right-0 {{ theme.is_rtl ? 'flip-x' : '' }}"></i>
            </div>
          </div>
        </div>

        {# Loyalty #}
        {% if loyalty %}
          <salla-loyalty-panel
              prize-points="{{ loyalty.prize.points }}"
              prize-title="{{ loyalty.prize.title }}">
          </salla-loyalty-panel>
        {% endif %}

        {# Gifting #}
        <div id="cart-gifting" class="mek-cart__gifting {{ gift.enabled ? '' : 'hidden' }}">
          <salla-gifting
              id="salla-gifting"
              widget-title="{{ trans('pages.cart.gift_widget_title') }}"
              widget-subtitle="{{ gift.text }}"
              {{ gift.type }}-products
              vertical>
          </salla-gifting>
        </div>

        {# Order summary #}
        <div class="mek-cart__order-summary">
          <h2 class="mek-eyebrow mek-cart__summary-title">{{ trans('pages.cart.summary') }}</h2>

          <div class="mek-cart__summary-row">
            <span>{{ trans(cart.tax_amount ? 'pages.cart.items_total_without_tax' : 'pages.cart.items_total') }}</span>
            <b id="sub-total">{{ cart.sub_total|money }}</b>
          </div>

          {% if cart.options|length %}
            <div class="mek-cart__summary-row">
              <span>{{ trans('pages.cart.order_options_total') }}</span>
              <b id="cart-options-total">{{ cart.options_total|money }}</b>
            </div>
          {% endif %}

          <div class="mek-cart__summary-row {{ cart.has_shipping ? '' : 'hidden' }}" id="shipping-cost">
            <span>{{ trans('pages.cart.shipping_cost') }}</span>
            <b>{{ cart.real_shipping_cost|money }}</b>
          </div>

          {% if store.settings.cart.apply_coupon_enabled %}
            <div class="mek-cart__coupon">
              <salla-cart-coupons></salla-cart-coupons>
            </div>
          {% endif %}

          <div class="mek-cart__summary-row {{ cart.total_discount ? '' : 'hidden' }}" id="total-discount">
            <span>{{ trans('pages.cart.discount') }}</span>
            <b>- {{ cart.total_discount|money }}</b>
          </div>

          {% if cart.tax_amount %}
            <div class="mek-cart__summary-row">
              <span>{{ trans('pages.cart.VAT_tax_amount') }}</span>
              <b id="tax-amount">{{ cart.tax_amount|money }}</b>
            </div>
          {% endif %}

          <div class="mek-cart__summary-row mek-cart__summary-row--total">
            <span>{{ trans('pages.cart.final_total') }}</span>
            <b data-cart-total>{{ cart.total|money }}</b>
          </div>

          <div class="cart-submit-wrap mek-cart__checkout-btn">
            {% hook 'cart:submit.start' %}
            <salla-button id="cart-submit" loader-position="center" width="wide">
              {{ trans('pages.cart.complete_order') }}
            </salla-button>
            {% hook 'cart:submit.end' %}
          </div>
        </div>

        <salla-tiered-offer></salla-tiered-offer>

        {% hook 'cart:summary.end' %}
      </div>
    {% endif %}
  </div>{# /.mek-cart #}
</div>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
