{#
| Variable     | Type   | Description |
|--------------|--------|-------------|
| page         | Page   |             |
| page.title   | string |             |
| page.content | string | HTML        |
| page.url     | string |             |
| page.slug    | string |             |
#}
{% extends "layouts.master" %}
{% block content %}

<div class="container">
  <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>
</div>

<section class="mek-page-single">
  <div class="container">
    <div class="mek-page-single__inner">
      <h1 class="mek-display mek-page-single__title js-mek-reveal">{{ page.title }}</h1>
      <div class="mek-page-single__rule" aria-hidden="true"></div>
      <div class="mek-page-single__body">
        {{ page.content|raw }}
      </div>
      <salla-comments item-id="{{ page.id }}" type="page"></salla-comments>
    </div>
  </div>
</section>

{% endblock %}
