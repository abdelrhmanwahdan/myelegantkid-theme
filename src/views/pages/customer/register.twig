{% extends "layouts.master" %}
{% block content %}

<section class="mek-auth">
  <div class="mek-auth__inner">

    {# Brand header #}
    <div class="mek-auth__brand">
      {% if store.logo %}
        <a href="{{ link('/') }}" class="mek-auth__logo-link">
          <img src="{{ store.logo }}" alt="{{ store.name }}" class="mek-auth__logo" width="140">
        </a>
      {% endif %}
      <p class="mek-auth__tagline" dir="ltr">MY ELEGANT KID · HAIL</p>
    </div>

    <div class="mek-auth__card">
      <h1 class="mek-display mek-auth__title">
        {{ theme.is_rtl ? 'إنشاء حساب' : 'Create account' }}
      </h1>
      <p class="mek-auth__subtitle">
        {{ theme.is_rtl
          ? 'انضمي إلى عالم أناقة الأطفال'
          : 'Join the world of children\'s elegance' }}
      </p>

      <salla-register class="mek-auth__form"></salla-register>

      <p class="mek-auth__switch">
        {{ theme.is_rtl ? 'لديكِ حساب بالفعل؟' : 'Already have an account?' }}
        <a href="{{ link('customer.login') }}" class="mek-auth__switch-link">
          {{ theme.is_rtl ? 'تسجيل الدخول' : 'Sign in' }}
        </a>
      </p>
    </div>

  </div>
</section>

{% endblock %}
