{#
| Variable   | Type         | Description                                                |
|------------|--------------|------------------------------------------------------------|
| page       | object       |                                                            |
| page.title | string       |                                                            |
| brands     | Collection[] | Brands grouped by char, ex:{b:[{'name':'brand1',...},...]} |
#}
{% extends "layouts.master" %}
{% block content %}

<div class="container">
  <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
    <salla-breadcrumb></salla-breadcrumb>
  </nav>
</div>

<section class="mek-brands container">
  <div class="mek-section-header js-mek-reveal">
    <h1 class="mek-display mek-section-title">{{ page.title }}</h1>
  </div>

  {% if brands|length %}

    {# Alphabet nav #}
    <nav class="mek-brands__alpha-nav" aria-label="{{ trans('pages.brands.alphabet_nav') ?? 'Brands index' }}">
      <ul class="brands-nav" id="brands-nav">
        {% for char, brands_group in brands %}
          <li>
            <a class="mek-brands__alpha-link"
               href="#brand-section-{{ loop.index }}"
               data-id="{{ loop.index }}">
              {{ char }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    {% hook 'brands:index.items.start' %}

    {% for char, brandGroup in brands %}
      <section id="brand-section-{{ loop.index }}" class="mek-brands__group">
        <div class="mek-brands__group-header">
          <span class="mek-brands__group-char" data-id="{{ loop.index }}">{{ char }}</span>
          <div class="mek-brands__group-rule" aria-hidden="true"></div>
        </div>

        <div class="mek-brands__grid">
          {% for brand in brandGroup %}
            <a href="{{ brand.url }}" class="mek-brands__item" title="{{ brand.name }}">
              <img src="{{ brand.logo }}"
                   alt="{{ brand.name }}"
                   width="400"
                   height="300"
                   loading="lazy"
                   class="mek-brands__logo">
            </a>
          {% endfor %}
        </div>
      </section>
    {% endfor %}

    {% hook 'brands:index.items.end' %}

  {% else %}
    <div class="no-content-placeholder">
      <span class="rounded-icon !w-36 !h-36 bg-cream mb-6">
        <i class="sicon-award-ribbon text-6xl block text-mist"></i>
      </span>
      <h2 class="mek-eyebrow mb-2">{{ trans('pages.brands.non_brands') }}</h2>
      <p class="text-sm text-mist">{{ trans('pages.brands.try_again') }}</p>
    </div>
  {% endif %}
</section>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'pages.js' | asset }}"></script>
{% endblock %}
