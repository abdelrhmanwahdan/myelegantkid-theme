{#
| Variable            | Type   | Description                            |
|---------------------|--------|----------------------------------------|
| page                | object |                                        |
| order               | Order  |                                        |
| thank_you           | string |                                        |
| share_message       | string |                                        |
| short_share_message | string |                                        |
#}
{% extends "layouts.master" %}
{% block content %}

{% hook 'thank-you:start' %}

<div class="mek-thankyou">
  <div class="container">

    {# Breadcrumb #}
    <nav class="mek-breadcrumb" aria-label="{{ trans('common.titles.breadcrumb') }}">
      <ol class="flex items-center gap-2 text-[10.5px] tracking-[0.25em] uppercase text-mist font-light">
        <li><a href="{{ link('/') }}" class="hover:text-ink transition-colors">{{ trans('common.titles.home') }}</a></li>
        <li aria-hidden="true">›</li>
        <li>{{ thank_you_title }}</li>
      </ol>
    </nav>

    {# ── Success card ──────────────────────────────────── #}
    <div class="mek-thankyou__card js-mek-reveal">
      <div class="mek-thankyou__hero">
        <div class="mek-thankyou__check" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h1 class="mek-display mek-thankyou__title thanks-item opacity-0">{{ thank_you_title }}</h1>
        <p class="mek-thankyou__ref thanks-item opacity-0">
          {{ trans('pages.thank_you.order_id') }}
          <salla-button
              class="relative"
              onclick="app.copyToClipboard(event)"
              color="dark"
              shape="link"
              data-content="{{ order.reference_id }}">
            <span>#{{ order.reference_id }}</span>
            <i class="copy-icon sicon-swap-stroke pointer-events-none rtl:me-1 ltr:ms-1"></i>
          </salla-button>
        </p>
        <salla-button
            class="mek-thankyou__details-btn thanks-item opacity-0"
            onclick="salla.order.show({order_id:'{{ order.id }}', url:'{{ order.url }}'})">
          <i class="sicon-newspaper rtl:ms-1 ltr:me-1"></i>
          {{ trans('pages.thank_you.order_details') }}
        </salla-button>
      </div>

      {% if order.instructions %}
        <article class="mek-thankyou__instructions article article--main article--small">
          {{ order.instructions|raw }}
        </article>
      {% endif %}

      {% for message in messages %}
        <div class="mek-thankyou__message">
          <span>{{ message }}</span>
        </div>
      {% endfor %}

      {% hook 'thank-you:items.start' %}
      {% hook 'thank-you:items.end' %}
    </div>

    <salla-next-order-coupon></salla-next-order-coupon>

    {# ── Info blocks ───────────────────────────────────── #}
    <div class="mek-thankyou__blocks">
      {% if order.email_sent %}
        <div class="mek-thankyou__block">
          <i class="sicon-newspaper-alt mek-thankyou__block-icon"></i>
          <p class="mek-thankyou__block-label">{{ trans('pages.thank_you.email_sent') }}</p>
          <b class="mek-thankyou__block-val">{{ order.customer.email }}</b>
        </div>
      {% else %}
        <div class="mek-thankyou__block" id="invoice-form">
          <i class="sicon-newspaper-alt mek-thankyou__block-icon"></i>
          <p class="mek-thankyou__block-label">{{ trans('pages.thank_you.resend_email') }}</p>
          <form onsubmit="return salla.form.onSubmit('order.sendInvoice', event)" class="mek-thankyou__email-form">
            <input type="email"
                   class="mek-thankyou__email-input"
                   placeholder="your@email.com"
                   required
                   name="email">
            <salla-button type="submit" loader-position="center">
              {{ trans('blocks.comments.submit') }}
            </salla-button>
          </form>
        </div>
      {% endif %}

      <div class="mek-thankyou__block">
        <i class="sicon-mail-letter mek-thankyou__block-icon"></i>
        <p class="mek-thankyou__block-label">{{ trans('common.titles.support') }}</p>
        <div class="mek-thankyou__contacts">
          {% if store.contacts.mobile %}
            <a href="tel:{{ store.contacts.mobile }}" class="mek-thankyou__contact">
              <i class="sicon-phone"></i>
              <span class="unicode">{{ store.contacts.mobile }}</span>
            </a>
          {% endif %}
          {% if store.contacts.whatsapp %}
            <a href="https://wa.me/{{ store.contacts.whatsapp|replace({' ': '', '+': '', '-': ''}) }}"
               class="mek-thankyou__contact"
               target="_blank"
               rel="noopener">
              <i class="sicon-whatsapp"></i>
              <span class="unicode">{{ store.contacts.whatsapp }}</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    {% hook 'thank-you:end' %}
  </div>
</div>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
